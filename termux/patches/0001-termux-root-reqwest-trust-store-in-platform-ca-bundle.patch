diff --git a/crates/provider/src/tls.rs b/crates/provider/src/tls.rs
new file mode 100644
index 0000000..e788d1a
--- /dev/null
+++ b/crates/provider/src/tls.rs
@@ -0,0 +1,110 @@
+//! Trust-store selection for outbound HTTP.
+//!
+//! reqwest picks a certificate verifier on its own, but its Android choice
+//! assumes a JVM, which a bare Termux process does not have. This module is
+//! the single place where that assumption is corrected.
+
+#[cfg(target_os = "android")]
+use std::path::PathBuf;
+#[cfg(target_os = "android")]
+use std::sync::LazyLock;
+
+/// Fallback for the overwhelmingly common Termux prefix. `$PREFIX` is a runtime
+/// variable, so it cannot be baked in with `env!`.
+#[cfg(target_os = "android")]
+const TERMUX_CA_BUNDLE: &str = "/data/data/com.termux/files/usr/etc/tls/cert.pem";
+
+/// Root the client's trust store in the platform's CA bundle.
+///
+/// On every platform except Android this is the identity function: reqwest
+/// already selects a verifier that works there (webpki-roots, or the OS
+/// verifier via `rustls-native-certs`).
+///
+/// Android is the exception. `rustls-platform-verifier` is the only verifier
+/// reqwest selects there, and it is JVM-backed: its `android.rs` reaches
+/// `GLOBAL.get().expect("Expect rustls-platform-verifier to be initialized")`.
+/// Without a JVM `Context` the first handshake panics instead of returning an
+/// error, so the agent dies on its first network call with a message that
+/// names neither the provider nor the cause. `tls_certs_only` swaps the
+/// platform verifier out for plain webpki rooted at the supplied certificates,
+/// which needs nothing outside this process.
+#[cfg(target_os = "android")]
+pub fn apply_platform_tls(builder: reqwest::ClientBuilder) -> reqwest::ClientBuilder {
+    let certs = android_root_certs();
+    if certs.is_empty() {
+        // Leaving the builder untouched means reqwest keeps
+        // rustls-platform-verifier and panics on the first handshake. That is
+        // the pre-patch behaviour and it is loud, which beats a client that
+        // builds successfully and then fails every request with
+        // UnknownIssuer.
+        return builder;
+    }
+    builder.tls_certs_only(certs.to_vec())
+}
+
+/// Identity function on non-Android targets. See the Android version above.
+#[cfg(not(target_os = "android"))]
+pub fn apply_platform_tls(builder: reqwest::ClientBuilder) -> reqwest::ClientBuilder {
+    builder
+}
+
+/// Parse the CA bundle once per process. Parsing 121 PEM certificates per
+/// client construction is wasteful when a caller rebuilds clients often.
+#[cfg(target_os = "android")]
+static ANDROID_ROOT_CERTS: LazyLock<Vec<reqwest::Certificate>> =
+    LazyLock::new(load_android_root_certs);
+
+#[cfg(target_os = "android")]
+fn android_root_certs() -> &'static [reqwest::Certificate] {
+    &ANDROID_ROOT_CERTS
+}
+
+#[cfg(target_os = "android")]
+fn android_root_certs_path() -> PathBuf {
+    std::env::var_os("SSL_CERT_FILE")
+        .map(PathBuf::from)
+        .or_else(|| {
+            std::env::var_os("PREFIX").map(|prefix| PathBuf::from(prefix).join("etc/tls/cert.pem"))
+        })
+        .unwrap_or_else(|| PathBuf::from(TERMUX_CA_BUNDLE))
+}
+
+#[cfg(target_os = "android")]
+fn load_android_root_certs() -> Vec<reqwest::Certificate> {
+    let path = android_root_certs_path();
+    let parsed = match std::fs::read(&path) {
+        Ok(pem) => reqwest::Certificate::from_pem_bundle(&pem),
+        Err(err) => {
+            eprintln!(
+                "smelt: android TLS roots: could not read {}: {err}",
+                path.display()
+            );
+            return Vec::new();
+        }
+    };
+
+    match parsed {
+        Ok(certs) if !certs.is_empty() => {
+            eprintln!(
+                "smelt: android TLS roots: {} certificates from {}",
+                certs.len(),
+                path.display()
+            );
+            certs
+        }
+        Ok(_) => {
+            eprintln!(
+                "smelt: android TLS roots: {} contained no certificates",
+                path.display()
+            );
+            Vec::new()
+        }
+        Err(err) => {
+            eprintln!(
+                "smelt: android TLS roots: could not parse {}: {err}",
+                path.display()
+            );
+            Vec::new()
+        }
+    }
+}
