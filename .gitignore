# Upstream builds into target/; so does anyone running termux/ci by hand.
target/

# Local artifact output from a manual termux/ci run.
#
# The CI build itself clones upstream into $HOME/smelt and writes to /out, so
# nothing in this repo is ever a build directory. These only appear when the
# pipeline is exercised by hand.
out/
dist/

__pycache__/
*.json.gz
